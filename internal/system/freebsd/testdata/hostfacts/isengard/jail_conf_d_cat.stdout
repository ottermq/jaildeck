goodiesdb {
  exec.start = "/bin/sh /etc/rc";
  exec.stop = "/bin/sh /etc/rc.shutdown";
  exec.consolelog = "/var/log/jail_console_${name}.log";

  allow.raw_sockets;
  exec.clean;
  mount.devfs;

  host.hostname = "${name}";
  path = "/usr/local/jails/containers/${name}";

  ip4 = inherit;
  interface = em0;
}
ottermq {
  exec.start = "/bin/sh /etc/rc";
  exec.stop = "/bin/sh /etc/rc.shutdown";
  exec.consolelog = "/var/log/jail_console_${name}.log";

  allow.raw_sockets;
  exec.clean;
  mount.devfs;

  host.hostname = "${name}";
  path = "/usr/local/jails/containers/${name}";

  ip4 = inherit;
  interface = em0;
}
postgres {
  exec.start = "/bin/sh /etc/rc";
  exec.stop = "/bin/sh /etc/rc.shutdown";
  exec.consolelog = "/var/log/jail_console_${name}.log";

  allow.raw_sockets;
  exec.clean;
  mount.devfs;

  host.hostname = "${name}";
  path = "/usr/local/jails/containers/${name}";

  ip4.addr = 192.168.1.101;
  interface = em0;

  sysvshm = new;
  sysvsem = new;
  sysvmsg = new;
}
