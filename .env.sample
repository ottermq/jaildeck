#JAILDECK_PORT=8888
#JAILDECK_HOST=127.0.0.1
#JAILDECK_STATE_DIR="/var/db/jaildeck"
#JAILDECK_AUDIT_LOG="/var/log/jaildeck/audit.log"
#JAILDECK_LOG_LEVEL=info

# The ZFS pool holding <pool>/jails. Empty discovers it, which works only when
# the host has exactly one pool; with several, Jail Deck will not guess.
#JAILDECK_ZFS_POOL=

# fake runs against an in-memory host, so the API and the web interface can be
# developed on any OS. freebsd is the default and needs a real FreeBSD host.
#JAILDECK_ADAPTER=freebsd

# A unix socket listener beside TCP, for a local automation client that wants
# neither a port nor TLS (JD-002). The socket is mode 0660; an empty group
# leaves it in the process's own, which for a root service is wheel. The API
# token is still required on it. SOCKET_ONLY=true drops the TCP listener.
#JAILDECK_SOCKET=/var/run/jaildeck.sock
#JAILDECK_SOCKET_GROUP=
#JAILDECK_SOCKET_ONLY=false

# The default VM network, set up by `jaildeck init vm-network` or
# PUT /api/networks/default (JD-040): a private vm-bhyve switch Jail Deck owns,
# the host's address on it (the guests' gateway), and outbound NAT through a PF
# anchor file Jail Deck writes. The egress interface defaults to the one the
# default route uses.
#JAILDECK_VM_SWITCH=jaildeck
#JAILDECK_VM_ADDRESS=10.88.0.1/24
#JAILDECK_VM_EGRESS=
#JAILDECK_PF_ANCHOR_DIR=/usr/local/etc/jaildeck/pf

# Tenant networks (JD-043) get a /24 each from this block.
#JAILDECK_NETWORK_RANGE=10.92.0.0/16

# The browser console (JD-042). A session nothing has been typed into for this
# long is closed; 0 never closes one for that.
#JAILDECK_CONSOLE_IDLE=30m
# Hosts a page may open a console from besides this host itself, for a proxy
# that rewrites Host. Comma-separated; * matches within a name.
#JAILDECK_CONSOLE_ORIGINS=
