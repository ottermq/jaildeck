#!/bin/sh
#
# PROVIDE: jaildeck
# REQUIRE: LOGIN FILESYSTEMS
# KEYWORD: shutdown
#
# Jail Deck — FreeBSD jails dashboard and host agent.
#
# Add to /etc/rc.conf to enable, and set only what differs from the defaults
# below; every knob maps to the environment variable of the same name upper-cased
# (see .env.sample and the README's configuration table):
#
#   jaildeck_enable="YES"
#   jaildeck_zfs_pool="tank"      # required on a host with more than one pool
#   #jaildeck_host="127.0.0.1"    # non-loopback needs TLS in front (JD-002)
#   #jaildeck_port="8888"
#   #jaildeck_state_dir="/var/db/jaildeck"
#   #jaildeck_audit_log="/var/log/jaildeck/audit.log"
#   #jaildeck_log_level="info"
#   #jaildeck_adapter="freebsd"
#   #jaildeck_binary="/usr/local/sbin/jaildeck"
#
# Jail Deck runs as root (JD-001) and will not start without an operator
# credential, so run `jaildeck passwd` once before enabling the service.

. /etc/rc.subr

name="jaildeck"
rcvar="jaildeck_enable"
desc="FreeBSD jails dashboard and host agent"

load_rc_config "$name"

: ${jaildeck_enable:="NO"}
: ${jaildeck_binary:="/usr/local/sbin/jaildeck"}
: ${jaildeck_host:="127.0.0.1"}
: ${jaildeck_port:="8888"}
: ${jaildeck_adapter:="freebsd"}
: ${jaildeck_state_dir:="/var/db/jaildeck"}
: ${jaildeck_audit_log:="/var/log/jaildeck/audit.log"}
: ${jaildeck_log_level:="info"}
: ${jaildeck_zfs_pool:=""}
# daemon(8) flags. -S sends the process's stdout and stderr to syslog, which is
# why the log handler drops its own timestamps. Add -r here to have daemon(8)
# restart Jail Deck if it exits; it is left off so that `service jaildeck stop`
# signals the process rc.subr is tracking and nothing puts it back.
: ${jaildeck_daemon_args:="-S -T ${name}"}

# NOT jaildeck_program: rc.subr reserves ${name}_program as the override for
# ${command}, so naming it that makes rc.subr run Jail Deck with daemon(8)'s
# flags as its arguments, and Jail Deck exits with `unknown command: "-S"`.
# ${command} here is daemon(8); Jail Deck is its argument -- the same shape as
# the zrepl and tailscaled scripts this host already runs.
pidfile="/var/run/${name}.pid"
procname="${jaildeck_binary}"
command="/usr/sbin/daemon"
command_args="${jaildeck_daemon_args} -p ${pidfile} ${procname}"

# Config reaches Jail Deck as environment variables; it reads no config file of
# its own, and the .env it loads is a development convenience read from the
# working directory. rc.subr exports these for ${command}.
jaildeck_env="JAILDECK_HOST=${jaildeck_host} \
JAILDECK_PORT=${jaildeck_port} \
JAILDECK_ADAPTER=${jaildeck_adapter} \
JAILDECK_STATE_DIR=${jaildeck_state_dir} \
JAILDECK_AUDIT_LOG=${jaildeck_audit_log} \
JAILDECK_LOG_LEVEL=${jaildeck_log_level} \
JAILDECK_ZFS_POOL=${jaildeck_zfs_pool}"

start_precmd="jaildeck_prestart"

jaildeck_prestart()
{
	# Both hold secrets -- the credential hash and API tokens in the state dir,
	# and every command Jail Deck ran in the audit log -- so 0700, which is what
	# `jaildeck passwd` and `jaildeck init` create them as.
	install -d -m 0700 -o root -g wheel "${jaildeck_state_dir}" || return 1
	install -d -m 0700 -o root -g wheel "$(dirname "${jaildeck_audit_log}")" || return 1
}

run_rc_command "$1"
