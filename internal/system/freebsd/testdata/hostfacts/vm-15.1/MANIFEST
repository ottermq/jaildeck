version_u	freebsd-version -u	exit=0
version_k	freebsd-version -k	exit=0
uname	uname -a	exit=0
sysctl_racct	sysctl -n kern.racct.enable	exit=0
sysctl_racct_full	sysctl kern.racct.enable	exit=0
sysctl_racct_absent	sysctl -n kern.racct.nosuchknob	exit=1
ifconfig_bridge_group	ifconfig -g bridge	exit=0
ifconfig_list	ifconfig -l	exit=0
devfs_rules_etc	cat /etc/devfs.rules	exit=1
devfs_rules_defaults	cat /etc/defaults/devfs.rules	exit=1
devfs_rules_headers	grep -h "^\[" /etc/devfs.rules /etc/defaults/devfs.rules	exit=2
dmesg_vtx	dmesg | grep -iE "VT-x|SVM|EPT|UG"	exit=0
dmesg_cpu_head	dmesg | grep -iE "^CPU|Features|VT-x|AMD" | head -20	exit=0
sysctl_vmm	sysctl hw.vmm	exit=1
pfctl_info	doas pfctl -s info	exit=1
pfctl_rules	doas pfctl -s rules	exit=1
kldstat_pf	kldstat -m pf	exit=1
service_pf_status	doas service pf status	exit=1
jail_conf	cat /etc/jail.conf	exit=0
jail_conf_d	ls -la /etc/jail.conf.d	exit=0
zpool_list_h	zpool list -H -o name	exit=0
zpool_list	zpool list	exit=0
zfs_list_recursive	zfs list -H -o name,mountpoint -r zroot	exit=0
zfs_list_jails_r	zfs list -H -o name,mountpoint -r zroot/jails	exit=0
zfs_list_mixed	zfs list -H -o name,mountpoint zroot zroot/definitely-not-here	exit=1
zfs_list_absent	zfs list -H -o name,mountpoint zroot/definitely-not-here	exit=1
zfs_list_absent_pool	zfs list -H -o name,mountpoint -r nosuchpool	exit=1
zfs_get_mountpoint	zfs get -H -o value mountpoint zroot	exit=0
zfs_list_all	zfs list -H -o name,mountpoint	exit=0
