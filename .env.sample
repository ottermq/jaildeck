#JAILDECK_PORT=8888
#JAILDECK_HOST=127.0.0.1
#JAILDECK_STATE_DIR="/var/db/jaildeck"
#JAILDECK_AUDIT_LOG="/var/log/jaildeck/audit.log"
#JAILDECK_LOG_LEVEL=info

# fake runs against an in-memory host, so the API and the web interface can be
# developed on any OS. freebsd is the default and needs a real FreeBSD host.
#JAILDECK_ADAPTER=freebsd
