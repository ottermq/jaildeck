zroot	no	on	none
zroot/ROOT	no	on	none
zroot/ROOT/default	yes	noauto	/
zroot/home	yes	on	/home
zroot/jails	yes	on	/usr/local/jails
zroot/jails/containers	yes	on	/usr/local/jails/containers
zroot/jails/containers/ottermq	yes	on	/usr/local/jails/containers/ottermq
zroot/jails/media	yes	on	/usr/local/jails/media
zroot/jails/templates	yes	on	/usr/local/jails/templates
zroot/jails/templates/15.1-RELEASE	yes	on	/usr/local/jails/templates/15.1-RELEASE
zroot/tmp	yes	on	/tmp
zroot/usr	no	off	/usr
zroot/usr/obj	yes	on	/usr/obj
zroot/usr/ports	yes	on	/usr/ports
zroot/usr/src	yes	on	/usr/src
zroot/var	no	off	/var
zroot/var/audit	yes	on	/var/audit
zroot/var/crash	yes	on	/var/crash
zroot/var/log	yes	on	/var/log
zroot/var/mail	yes	on	/var/mail
zroot/var/tmp	yes	on	/var/tmp
