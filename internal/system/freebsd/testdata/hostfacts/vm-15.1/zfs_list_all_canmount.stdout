zroot	none	on
zroot/ROOT	none	on
zroot/ROOT/default	/	noauto
zroot/home	/home	on
zroot/jails	/usr/local/jails	on
zroot/jails/containers	/usr/local/jails/containers	on
zroot/jails/containers/ottermq	/usr/local/jails/containers/ottermq	on
zroot/jails/media	/usr/local/jails/media	on
zroot/jails/templates	/usr/local/jails/templates	on
zroot/jails/templates/15.1-RELEASE	/usr/local/jails/templates/15.1-RELEASE	on
zroot/tmp	/tmp	on
zroot/usr	/usr	off
zroot/usr/obj	/usr/obj	on
zroot/usr/ports	/usr/ports	on
zroot/usr/src	/usr/src	on
zroot/var	/var	off
zroot/var/audit	/var/audit	on
zroot/var/crash	/var/crash	on
zroot/var/log	/var/log	on
zroot/var/mail	/var/mail	on
zroot/var/tmp	/var/tmp	on
